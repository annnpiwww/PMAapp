# =====================================================
# BssparkingTimeMark — Build Environment Variables
# =====================================================
# Copy file ini ke .env dan isi nilai-nilai berikut:
#   cp .env.example .env
#
# Kemudian build APK dengan:
#   source .env && flutter build apk \
#     --dart-define=BSS_AI_API_KEY=$BSS_AI_API_KEY \
#     --dart-define=BSS_GSHEET_TOKEN=$BSS_GSHEET_TOKEN \
#     --dart-define=BSS_GSHEET_SCRIPT_URL=$BSS_GSHEET_SCRIPT_URL \
#     --dart-define=BSS_GSHEET_SPREADSHEET_URL=$BSS_GSHEET_SPREADSHEET_URL
#
# Atau gunakan build.sh untuk shortcut.
# =====================================================

# Google AI Studio API Key (Gemini Flash Lite)
BSS_AI_API_KEY=your-google-ai-studio-api-key-here

# Google Sheets Webhook Token
BSS_GSHEET_TOKEN=your-secret-token-here

# Google Apps Script Webhook URL
BSS_GSHEET_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Spreadsheet URL
BSS_GSHEET_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
