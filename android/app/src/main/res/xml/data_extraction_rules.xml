<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31): data sensitif (PIN hash, API key, session user,
  lokasi, submission) TIDAK ikut backup maupun device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
